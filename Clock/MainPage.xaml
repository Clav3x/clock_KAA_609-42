<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Clock.MainPage"
             xmlns:local="clr-namespace:Clock">

                

    <Grid WidthRequest="500"
      HorizontalOptions="Center"
      VerticalOptions="Center"
      RowDefinitions="Auto,Auto"
      ColumnDefinitions="*,*,*,*"
      ColumnSpacing="10">

    <Button Grid.Row="0" Grid.Column="0" Text="Сургут"   Clicked="CityClicked" BackgroundColor="#2B2B2B" TextColor="#37FD12" CornerRadius="8"/>
    <Button Grid.Row="0" Grid.Column="1" Text="Москва"   Clicked="CityClicked" BackgroundColor="#2B2B2B" TextColor="#37FD12" CornerRadius="8"/>
    <Button Grid.Row="0" Grid.Column="2" Text="Токио"    Clicked="CityClicked" BackgroundColor="#2B2B2B" TextColor="#37FD12" CornerRadius="8"/>
    <Button Grid.Row="0" Grid.Column="3" Text="Нью-Йорк" Clicked="CityClicked" BackgroundColor="#2B2B2B" TextColor="#37FD12" CornerRadius="8"/>

    <local:ClockView x:Name="worldClock"
                     Grid.Row="1" Grid.ColumnSpan="4"
                     HeightRequest="200"/>

</Grid>


</ContentPage>

